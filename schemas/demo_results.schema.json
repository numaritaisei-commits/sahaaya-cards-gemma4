{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sahaaya-cards:runtime-demo-results:1.0",
  "title": "Sahaaya Cards validated Gemma 4 runtime artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "generated_at_utc", "status", "model_ref", "model_path", "run_configuration", "runtime_provenance", "safety_limitations", "failures", "notices"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project": {"const": "Sahaaya Cards"},
    "generated_at_utc": {"type": "string", "minLength": 1, "maxLength": 80},
    "status": {"const": "PASS"},
    "model_ref": {"const": "keras/gemma4/keras/gemma4_instruct_2b/2"},
    "model_path": {"const": "/kaggle/input/models/keras/gemma4/keras/gemma4_instruct_2b/2"},
    "run_configuration": {
      "type": "object", "additionalProperties": false,
      "required": [
        "framework", "backend", "weight_dtype", "keras_hub_version",
        "wheel_dataset_ref", "wheel_sha256", "generator_max_length",
        "verifier_max_length", "minimum_completion_tokens", "sampler",
        "strip_prompt", "gpu", "tensorflow_gpu_visible", "internet_enabled",
        "external_apis"
      ],
      "properties": {
        "framework": {"const": "keras_hub"},
        "backend": {"const": "torch"},
        "weight_dtype": {"const": "float16"},
        "keras_hub_version": {"const": "0.28.0"},
        "wheel_dataset_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,38}/verified-keras-hub-028-gemma4$"},
        "wheel_sha256": {"const": "a28cb601f7fffb7f28add1bae8110459fc3ac7d9e2159453dfbda9e97271fc87"},
        "generator_max_length": {"const": 2048},
        "verifier_max_length": {"const": 3072},
        "minimum_completion_tokens": {"const": 512},
        "sampler": {"const": "greedy"},
        "strip_prompt": {"const": true},
        "gpu": {"const": "T4x2"},
        "tensorflow_gpu_visible": {"const": false},
        "internet_enabled": {"const": false},
        "external_apis": {"const": false}
      }
    },
    "runtime_provenance": {"$ref": "#/$defs/runtimeProvenance"},
    "safety_limitations": {"type": "array", "minItems": 4, "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "failures": {"type": "array", "maxItems": 0, "items": {"$ref": "#/$defs/failure"}},
    "notices": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/notice"}}
  },
  "$defs": {
    "runtimeProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "explicit_model_dtype", "global_policy", "gpu", "gpu_count", "keras_hub_version", "load_seconds", "memory_after_load", "memory_before_load", "model", "model_variable_bytes", "official_weights_loaded", "tensorflow_gpu_visible", "torch_version", "variable_bytes_by_device", "variable_bytes_by_dtype", "weight_dtype", "wheel"],
      "properties": {
        "backend": {"const": "torch"}, "explicit_model_dtype": {"const": "float16"},
        "global_policy": {"const": "float16"}, "gpu": {"const": "T4x2"}, "gpu_count": {"const": 2},
        "keras_hub_version": {"const": "0.28.0"}, "load_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 1800},
        "memory_after_load": {"$ref": "#/$defs/memory"}, "memory_before_load": {"$ref": "#/$defs/memory"},
        "model": {"type": "object", "additionalProperties": false, "required": ["file_count", "inventory_sha256", "total_bytes"], "properties": {"file_count": {"type": "integer", "minimum": 6, "maximum": 32}, "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "total_bytes": {"type": "integer", "minimum": 8e9, "maximum": 13e9}}},
        "model_variable_bytes": {"type": "integer", "minimum": 8e9, "maximum": 13e9},
        "official_weights_loaded": {"const": true}, "tensorflow_gpu_visible": {"const": false},
        "torch_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "variable_bytes_by_device": {"type": "object", "additionalProperties": false, "required": ["cuda:0"], "properties": {"cuda:0": {"type": "integer", "minimum": 8e9, "maximum": 13e9}}},
        "variable_bytes_by_dtype": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}},
        "weight_dtype": {"const": "float16"},
        "wheel": {"type": "object", "additionalProperties": false, "required": ["archive_bytes", "member_count", "record_entries_verified", "sha256"], "properties": {"archive_bytes": {"const": 1525623}, "member_count": {"const": 766}, "record_entries_verified": {"const": 765}, "sha256": {"const": "a28cb601f7fffb7f28add1bae8110459fc3ac7d9e2159453dfbda9e97271fc87"}}}
      }
    },
    "memory": {
      "type": "object", "additionalProperties": false,
      "required": ["allocated_bytes", "free_bytes", "peak_allocated_bytes", "reserved_bytes", "total_bytes"],
      "properties": {"allocated_bytes": {"type": "integer", "minimum": 0}, "free_bytes": {"type": "integer", "minimum": 0}, "peak_allocated_bytes": {"type": "integer", "minimum": 0}, "reserved_bytes": {"type": "integer", "minimum": 0}, "total_bytes": {"type": "integer", "minimum": 12e9}}
    },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["error_type", "failure_classification", "stage"],
      "properties": {"error_type": {"type": "string", "minLength": 1, "maxLength": 80}, "failure_classification": {"type": "string", "minLength": 1, "maxLength": 80}, "stage": {"type": "string", "minLength": 1, "maxLength": 80}}
    },
    "notice": {
      "type": "object", "additionalProperties": false,
      "required": ["notice_id", "source_sha256", "prompts", "raw_final_answers", "parsed", "token_budgets", "timing_seconds", "validation"],
      "properties": {
        "notice_id": {"enum": ["SYN-FLOOD-001", "SYN-WATER-002"]},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "prompts": {"$ref": "#/$defs/textPair"},
        "raw_final_answers": {"$ref": "#/$defs/textPair"},
        "parsed": {
          "type": "object", "additionalProperties": false, "required": ["generator", "verifier"],
          "properties": {"generator": {"$ref": "#/$defs/generator"}, "verifier": {"$ref": "#/$defs/verifier"}}
        },
        "token_budgets": {
          "type": "object", "additionalProperties": false, "required": ["generator", "verifier"],
          "properties": {"generator": {"$ref": "#/$defs/generatorBudget"}, "verifier": {"$ref": "#/$defs/verifierBudget"}}
        },
        "timing_seconds": {
          "type": "object", "additionalProperties": false, "required": ["generator", "verifier", "total"],
          "properties": {"generator": {"type": "number", "minimum": 0}, "verifier": {"type": "number", "minimum": 0}, "total": {"type": "number", "minimum": 0}}
        },
        "validation": {
          "type": "object", "additionalProperties": false, "required": ["passed", "errors"],
          "properties": {"passed": {"const": true}, "errors": {"type": "array", "maxItems": 0}}
        }
      }
    },
    "generatorBudget": {
      "type": "object", "additionalProperties": false,
      "required": ["completion_budget_tokens", "max_length", "minimum_completion_tokens", "prompt_tokens"],
      "properties": {"completion_budget_tokens": {"type": "integer", "minimum": 512}, "max_length": {"const": 2048}, "minimum_completion_tokens": {"const": 512}, "prompt_tokens": {"type": "integer", "minimum": 1, "maximum": 1536}}
    },
    "verifierBudget": {
      "type": "object", "additionalProperties": false,
      "required": ["completion_budget_tokens", "max_length", "minimum_completion_tokens", "prompt_tokens"],
      "properties": {"completion_budget_tokens": {"type": "integer", "minimum": 512}, "max_length": {"const": 3072}, "minimum_completion_tokens": {"const": 512}, "prompt_tokens": {"type": "integer", "minimum": 1, "maximum": 2560}}
    },
    "textPair": {
      "type": "object", "additionalProperties": false, "required": ["generator", "verifier"],
      "properties": {"generator": {"type": "string", "minLength": 1}, "verifier": {"type": "string", "minLength": 1}}
    },
    "generator": {
      "type": "object", "additionalProperties": false, "required": ["notice_id", "fact_ledger", "cards", "uncertainties"],
      "properties": {
        "notice_id": {"type": "string", "minLength": 1, "maxLength": 40},
        "fact_ledger": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/fact"}},
        "cards": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/card"}},
        "uncertainties": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 800}}
      }
    },
    "fact": {
      "type": "object", "additionalProperties": false, "required": ["fact_id", "kind", "value", "source_quote"],
      "properties": {
        "fact_id": {"type": "string", "pattern": "^F[1-9][0-9]*$"},
        "kind": {"enum": ["time", "place", "action", "contact", "constraint", "service", "warning"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 600},
        "source_quote": {"type": "string", "minLength": 1, "maxLength": 800}
      }
    },
    "card": {
      "type": "object", "additionalProperties": false, "required": ["language", "headline", "source_fact_ids", "actions", "do_not_infer"],
      "properties": {
        "language": {"enum": ["en", "hi", "ta"]}, "headline": {"type": "string", "minLength": 1, "maxLength": 140},
        "source_fact_ids": {"$ref": "#/$defs/factIds"},
        "actions": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/action"}},
        "do_not_infer": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false, "required": ["text", "fact_ids"],
      "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 260}, "fact_ids": {"$ref": "#/$defs/factIds"}}
    },
    "factIds": {"type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": {"type": "string", "pattern": "^F[1-9][0-9]*$"}},
    "verifier": {
      "type": "object", "additionalProperties": false,
      "required": ["notice_id", "verdict", "checks", "unsupported_claims", "language_warnings", "safety_note"],
      "properties": {
        "notice_id": {"type": "string", "minLength": 1, "maxLength": 40}, "verdict": {"const": "PASS"},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
        "unsupported_claims": {"type": "array", "maxItems": 0}, "language_warnings": {"type": "array", "maxItems": 0},
        "safety_note": {"type": "string", "minLength": 1, "maxLength": 800}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["claim_path", "supported", "fact_ids", "explanation"],
      "properties": {
        "claim_path": {"type": "string", "minLength": 1, "maxLength": 100}, "supported": {"const": true},
        "fact_ids": {"type": "array", "minItems": 0, "maxItems": 30, "uniqueItems": true, "items": {"type": "string", "pattern": "^F[1-9][0-9]*$"}}, "explanation": {"type": "string", "minLength": 1, "maxLength": 800}
      }
    }
  }
}
